/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

/style.css
  Cache-Control: no-cache

/icons/*
  Cache-Control: public, max-age=604800, immutable
